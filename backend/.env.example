# Copy this file to .env and adjust as needed.
# Currently unused by the code directly, but kept here so config (API keys,
# DB connection strings, etc.) has an obvious home once you add them.

# Example for when you move plant storage from in-memory to MongoDB:
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=renewable_forecasting

# Example if you add a severe-weather-alerts API key later:
# SEVERE_WEATHER_API_KEY=
