# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables & secrets
.env
.env.local
.env.*.local

# ML Models & Datasets (keep trained binaries out of Git tracking)
app/ml/saved_models/*.pkl
app/ml/saved_models/*.json
app/ml/saved_models/*.joblib
!app/ml/saved_models/.gitkeep

# IDEs & Code Editors
.vscode/
.idea/
*.swp
*.swo

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Logs & OS Specific Files
*.log
.DS_Store
Thumbs.db